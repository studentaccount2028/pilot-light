# Copy to .env.local and fill in. Never commit .env.local.

# Postgres. Local: postgres://localhost:5432/pilot_light   Hosted: your Neon URL.
DATABASE_URL=postgres://localhost:5432/pilot_light

# Twilio. Leave blank to run in simulated mode: nothing is sent and every
# message is labelled SIMULATED in the event log.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
# Set to 1 to force simulated mode even with credentials present.
TWILIO_DRY_RUN=

# Public https URL of this app (ngrok or Vercel). Needed for inbound replies
# and for key presses on voice calls. No trailing slash.
PUBLIC_BASE_URL=

# NWS requires a User-Agent with contact info, or it answers 403.
NWS_USER_AGENT=PilotLight/0.1 (you@example.com)

# Default speed for `npm run replay` (1 real minute = N simulated minutes).
REPLAY_CLOCK_MULTIPLIER=120

# Protects /replay and /town. Required in production; optional in local dev.
ADMIN_TOKEN=

# Protects /api/cron/tick when deployed with Vercel Cron.
CRON_SECRET=

# Phone numbers for the seeded Ossipee household (E.164). Optional: the seed
# uses fictional 555 numbers when these are blank.
SEED_PHONE_1=
SEED_PHONE_2=
SEED_PHONE_3=
SEED_PHONE_RESIDENT=
