{
  "name": "pilot-light",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "concurrently -n web,worker -c blue,yellow \"next dev\" \"tsx scripts/worker.ts\"",
    "dev:web": "next dev",
    "worker": "tsx scripts/worker.ts",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:seed": "tsx scripts/seed.ts",
    "setup": "npm run db:migrate && npm run db:seed",
    "replay": "tsx scripts/replay.ts",
    "test": "tsx --test tests/*.test.ts",
    "test:replay": "TWILIO_DRY_RUN=1 tsx scripts/replay.ts --assert --speed 3000",
    "backtest": "node scripts/backtest.mjs",
    "twilio:check": "tsx scripts/twilio-check.ts",
    "backtest:outages": "node scripts/backtest-outages.mjs"
  },
  "dependencies": {
    "drizzle-orm": "^0.45.4",
    "idb": "^8.0.4",
    "maplibre-gl": "^5.24.0",
    "next": "15.5.27",
    "pg": "^8.23.1",
    "react": "19.1.0",
    "react-dom": "19.1.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "concurrently": "^10.0.6",
    "dotenv": "^18.0.7",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9",
    "eslint-config-next": "15.5.27",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5"
  },
  "type": "module"
}
